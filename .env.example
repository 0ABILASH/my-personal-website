# Google Apps Script web app URL (deployed as Web app, access: Anyone)
# Leave empty to fall back to local /api/cv-download (needs server.js running)
VITE_SHEETS_URL=

# ─── Admin dashboard (server.js) ─────────────────────────────────────────────
# URL of the ADMIN Apps Script web app (gas/AdminCode.gs deployed as Web app).
# Leave empty to keep admin APIs disabled ("Admin backend not configured").
GAS_ADMIN_URL=

# Shared secret between server.js and the admin Apps Script (script property
# ADMIN_SECRET must match). Keep it long and random. NEVER set in .env.production.
GAS_ADMIN_SECRET=

# Admin login credentials. ADMIN_PASSWORD_HASH is a SHA-256 hex of the password,
# generated with: node scripts/hash-password.js
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
